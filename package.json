{
  "name": "mongodb-backup-service",
  "version": "1.0.0",
  "description": "Production MongoDB backup daemon with S3/R2 streaming, client-side encryption, automated restore drills, and Prometheus metrics",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mongodb-backup": "./dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js daemon",
    "backup": "node dist/index.js backup",
    "restore": "node dist/index.js restore",
    "verify": "node dist/index.js verify",
    "list": "node dist/index.js list",
    "prune": "node dist/index.js prune",
    "drill": "node dist/index.js drill",
    "oplog:tail": "node dist/index.js oplog:tail",
    "oplog:slice": "node dist/index.js oplog:slice",
    "oplog:list": "node dist/index.js oplog:list",
    "key:generate": "node dist/index.js key:generate",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "mongodb",
    "backup",
    "restore",
    "s3",
    "r2",
    "cloudflare-r2",
    "encryption",
    "prometheus",
    "streaming"
  ],
  "author": "bhatbazik",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1114.0",
    "@aws-sdk/lib-storage": "^3.1114.0",
    "dotenv": "^17.4.2",
    "mongodb": "^7.7.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.5",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
