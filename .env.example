# ==============================================================================
# MongoDB Connection
# ==============================================================================
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/production
MONGODB_DATABASE=production
MONGODB_EXCLUDE_COLLECTIONS=temp_logs,sessions

# Capture oplog entries during dump for point-in-time consistency (requires MONGODB_DATABASE=*)
MONGODB_OPLOG=false

# Continuous Point-in-Time Recovery (PITR) Oplog Archiver (requires replica set & MONGODB_DATABASE=*)
PITR_ENABLED=false
PITR_FLUSH_INTERVAL_SECONDS=60
PITR_MAX_SLICE_MB=16

# Concurrently dumped collections (lower to 1-2 for small host / 100GB+ datasets)
MONGODB_PARALLEL_COLLECTIONS=2

# Read preference for replica set dumps (secondaryPreferred, secondary, primaryPreferred, primary, nearest)
MONGODB_READ_PREFERENCE=secondaryPreferred

# ==============================================================================
# Storage Destination (AWS S3 or Local/NFS Filesystem)
# ==============================================================================
# Storage backend: "s3" (default) or "filesystem"
STORAGE_TYPE=s3

# Target bucket name and AWS credentials (required when STORAGE_TYPE=s3)
S3_BUCKET=mongodb-backups
S3_ACCESS_KEY_ID=your-aws-access-key-id
S3_SECRET_ACCESS_KEY=your-aws-secret-access-key
S3_REGION=us-east-1
S3_PREFIX=mongodb

# S3 Object Lock & Compliance Retention (WORM / Ransomware Immutability)
S3_OBJECT_LOCK_ENABLED=false
S3_OBJECT_LOCK_MODE=GOVERNANCE
S3_OBJECT_LOCK_RETENTION_DAYS=30
S3_OBJECT_LOCK_LEGAL_HOLD=false

# When STORAGE_TYPE=filesystem, specify local or mounted directory path
# STORAGE_PATH=/var/backups/mongodb

# Multipart upload tuning for large (100GB+) databases on small RAM machines
# Part size in MB (32MB allows up to 320GB archives without exceeding 10,000 part limit)
S3_PART_SIZE_MB=32
# Parallel chunk upload streams (2 keeps buffer memory footprint under ~70MB)
S3_QUEUE_SIZE=2

# Optional custom AWS S3 endpoint (e.g. AWS VPC Endpoint or LocalStack emulation)
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
S3_FORCE_PATH_STYLE=false

# ==============================================================================
# Multi-Engine Selection & Advanced Architecture (Logical, Physical)
# ==============================================================================
# Backup engine: "logical" (mongodump stream) or "physical" ($backupCursor WT hot copy)
BACKUP_ENGINE=logical

# Physical hot backup dbPath (required when BACKUP_ENGINE=physical)
# PHYSICAL_DB_PATH=/var/lib/mongodb
# PHYSICAL_ENCRYPTION_KEY_FILE=/etc/mongodb/keyfile
# PHYSICAL_DIRECTORY_PER_DB=false

# Multi-shard cluster coordination (distributed transaction consistency)
SHARDING_ENABLED=false
SHARDING_CONFIGSVR_URI=

# ==============================================================================
# Backup Schedule & Runtime
# ==============================================================================
# Standard 5-field cron expression (e.g. daily at 02:00)
BACKUP_CRON=0 2 * * *
BACKUP_TIMEZONE=UTC
BACKUP_TIMEOUT_MINUTES=180
BACKUP_ON_START=false
WORK_DIR=/tmp/mongodb-backup

# ==============================================================================
# Client-Side Encryption (AES-256-GCM Envelope Encryption)
# ==============================================================================
# Generate a 32-byte key via: npm run key:generate
# If left empty, backups are stored as standard gzip archives
ENCRYPTION_KEY=

# ==============================================================================
# Retention Policy (Grandfather-Father-Son)
# ==============================================================================
# Optional: automatically prune older backups after each successful run
RETENTION_KEEP_LAST=5
RETENTION_KEEP_DAILY=7
RETENTION_KEEP_WEEKLY=4
RETENTION_KEEP_MONTHLY=12

# ==============================================================================
# Automated Restore Drills
# ==============================================================================
# Staging/test database connection to restore into and verify document counts
DRILL_MONGODB_URI=
DRILL_CRON=0 4 * * 0

# ==============================================================================
# Notifications & Monitoring
# ==============================================================================
# Dead man's switch heartbeat ping (e.g. Healthchecks.io, Cronitor, BetterStack)
HEARTBEAT_URL=https://hc-ping.com/your-uuid-here
NOTIFY_ON_SUCCESS=true

# Slack incoming webhook
SLACK_WEBHOOK_URL=

# Generic HTTP webhook (POST JSON payload)
WEBHOOK_URL=

# SMTP Email alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=backups@example.com
SMTP_TO=devops@example.com,alerts@example.com

# ==============================================================================
# Observability & Health Server
# ==============================================================================
HTTP_PORT=8080
LOG_LEVEL=info